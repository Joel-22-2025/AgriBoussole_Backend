# Copiez ce fichier vers .env et adaptez les valeurs.

SECRET_KEY=changez-moi-en-production-une-cle-secrete-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (PostgreSQL en production ; SQLite par défaut en local)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=saei_db
# DB_USER=saei_user
# DB_PASSWORD=saei_password
# DB_HOST=localhost
# DB_PORT=5432

# Email (console backend en développement : les emails s'affichent dans les logs)
DEFAULT_FROM_EMAIL=saei-orientation@example.com
ADMIN_EMAIL=admin@example.com

# Super administrateur par défaut (commande create_default_superadmin)
DEFAULT_SUPERADMIN_EMAIL=superadmin@saei.bj
DEFAULT_SUPERADMIN_PASSWORD=SuperAdminSecret123!
