# Copier vers les variables d'environnement du service Render.

SECRET_KEY=remplacez-par-une-cle-aleatoire-longue
DEBUG=False
ALLOWED_HOSTS=.onrender.com

# PostgreSQL fourni par Render (DATABASE_URL est prioritaire sur DB_*)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Origine du frontend Vercel (sans slash final)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://votre-front.vercel.app
CSRF_TRUSTED_ORIGINS=https://votre-front.vercel.app

# Clé Groq de l'assistant Boussole
GROQ_API_KEY=votre-cle-groq

# Administrateur initial (optionnel mais recommandé)
DEFAULT_SUPERADMIN_EMAIL=admin@votre-domaine.com
DEFAULT_SUPERADMIN_PASSWORD=MotDePasseSolide123!

DEFAULT_FROM_EMAIL=saei-orientation@example.com
ADMIN_EMAIL=admin@example.com
